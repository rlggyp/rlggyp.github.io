---
import Section from '@components/Section.astro'
import {  name, job, avatar, location, resume } from '@resume'
---
<Section>
  <div  class="flex flex-col md:flex-row md:justify-between items-center text-center md:text-left mt-16">
    <img src={avatar} alt={name} class="md:order-last w-40 h-40 rounded-md object-cover my-3" />
    <div class="capitalize">
      <h1 class="text-3xl font-bold md:mt-[-0.5rem] my-[0.5rem]">{name}</h1>
      <h2 class="text-xl">{job}</h2>
      <h3 class="text-base">{location}</h3>
      <p class="text-xl mt-4">
        <a href={resume} target="_blank" class="text-base bg-gray-100 hover:bg-gray-200 rounded-md p-2"><spam>Resume</span></a>
      </p>
    </div>
  </div>
</Section>
